@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix units:  <http://lv2plug.in/ns/extensions/units#> .
@prefix mod:    <http://moddevices.com/ns/mod#> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/>.

<https://github.com/theKAOSSphere/four2one>
    a lv2:Plugin, lv2:UtilityPlugin ;

    doap:name "Four2One" ;
    doap:license "GPL-3.0-or-later" ;

    lv2:minorVersion 0;
    lv2:microVersion 1;

    mod:brand "KAOSS" ;
    mod:label "Four2One" ;

    rdfs:comment """Four2One is a simple mixer that combines four audio inputs into one output. It allows you to control which inputs are active and how they are mixed together using a mix law parameter. The mix law determines how the levels of the active inputs are weighted in the final output.""" ;

    doap:developer [
        foaf:name "KAOSS";
        foaf:mbox <mailto:thekaossphere@gmail.com>;
        foaf:homepage <https://github.com/theKAOSSphere>;
    ];

    doap:maintainer [
        foaf:name "KAOSS";
        foaf:homepage <https://github.com/theKAOSSphere>;
        foaf:mbox <mailto:thekaossphere@gmail.com>;
    ];

    lv2:port [
        a lv2:AudioPort ,
            lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in1" ;
        lv2:name "In1" ;
    ] , [
        a lv2:AudioPort ,
            lv2:InputPort ;
        lv2:index 1 ;
        lv2:symbol "in2" ;
        lv2:name "In2" ;
    ] , [
        a lv2:AudioPort ,
            lv2:InputPort ;
        lv2:index 2 ;
        lv2:symbol "in3" ;
        lv2:name "In3" ;
    ] , [
        a lv2:AudioPort ,
            lv2:InputPort ;
        lv2:index 3 ;
        lv2:symbol "in4" ;
        lv2:name "In4" ;
    ] , [
        a lv2:AudioPort ,
            lv2:OutputPort ;
        lv2:index 4 ;
        lv2:symbol "out" ;
        lv2:name "Out" ;
    ] , [
        a lv2:ControlPort ,
            lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "toggle1" ;
        lv2:name "Toggle 1" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled, lv2:integer;
    ] , [
        a lv2:ControlPort ,
            lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "toggle2" ;
        lv2:name "Toggle 2" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled, lv2:integer;
    ] , [
        a lv2:ControlPort ,
            lv2:InputPort ;
        lv2:index 7 ;
        lv2:symbol "toggle3" ;
        lv2:name "Toggle 3" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled, lv2:integer;
    ] , [
        a lv2:ControlPort ,
            lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "toggle4" ;
        lv2:name "Toggle 4" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled, lv2:integer;
    ] , [
        a lv2:ControlPort ,
            lv2:InputPort ;
        lv2:index 9 ;
        lv2:symbol "mix_law" ;
        lv2:name "Mix Law" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:integer, lv2:enumeration;
        lv2:scalePoint [rdfs:label "Sum"; rdf:value 0];
        lv2:scalePoint [rdfs:label "Equal Power"; rdf:value 1];
    ] .