@prefix modgui: <http://moddevices.com/ns/modgui#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .

<https://github.com/theKAOSSphere/four2one>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon-four2one.html> ;
        modgui:stylesheet <modgui/stylesheet-four2one.css> ;
        modgui:screenshot <modgui/screenshot-four2one.png> ;
        modgui:thumbnail <modgui/thumbnail-four2one.png> ;
        modgui:brand "KAOSS" ;
        modgui:label "Four2One" ;
        modgui:model "boxy" ;
        modgui:color "red" ;
        modgui:knob "black" ;
        modgui:port [
            lv2:index 0 ;
            lv2:symbol "toggle1" ;
            lv2:name "Toggle 1" ;
        ] , [
            lv2:index 1 ;
            lv2:symbol "toggle2" ;
            lv2:name "Toggle 2" ;
        ] , [
            lv2:index 2 ;
            lv2:symbol "toggle3" ;
            lv2:name "Toggle 3" ;
        ] , [
            lv2:index 3 ;
            lv2:symbol "toggle4" ;
            lv2:name "Toggle 4" ;
        ]
    ] .